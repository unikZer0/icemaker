# Dashboard host port (localhost only in Compose)
PORT=3100
# Wi-Fi device MQTT host port
MQTT_PORT=1884
# Set to the Windows PC's LAN IPv4 address, not a Docker container IP
MQTT_ADVERTISED_HOST=192.168.1.125
# Generate separate random values before running; never commit real credentials
MQTT_TOKEN=replace-with-a-random-device-token
USB_BRIDGE_TOKEN=replace-with-a-different-random-bridge-token
# Native Node listener/storage settings; Compose overrides these inside the container
HTTP_HOST=127.0.0.1
MQTT_HOST=0.0.0.0
DATA_DIR=./data
USB_MODE=local
# Windows USB agent (npm run usb); connects to the Docker-published MQTT port
BRIDGE_MQTT_HOST=127.0.0.1
SERIAL_PORT=COM11
SERIAL_BAUD=115200
# Admin login (server .env only; gateway downloads do not include these)
AUTH_ENABLED=true
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-random-admin-password
APP_ORIGIN=http://localhost:3100
# Set a domain before using compose.cloud.yaml
APP_DOMAIN=
# MQTT TLS is enabled by the cloud Compose overlay
MQTT_TLS=false
MQTT_TLS_CERT=
MQTT_TLS_KEY=
# Optional CA file on the USB gateway if using a private certificate authority
BRIDGE_TLS_CA=
# PostgreSQL (Compose keeps it private; no database host port is published)
STORAGE_BACKEND=postgres
POSTGRES_DB=icemaker
POSTGRES_USER=icemaker
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Keep this key with encrypted database backups. Do not regenerate after migration.
DATA_ENCRYPTION_KEY=replace-with-a-64-hex-encryption-key
